{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "events.json",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "type", "side", "city", "title", "date", "audience", "status", "needsConfirmation"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "type": { "enum": ["ritual", "meal", "celebration"] },
      "side": { "enum": ["groom", "bride", "common"] },
      "city": { "enum": ["Pune", "Indore", "TBD"] },
      "venueName": { "type": ["string", "null"] },
      "area": { "$ref": "#/definitions/l10n" },
      "room": { "$ref": "#/definitions/l10n" },
      "title": { "$ref": "#/definitions/l10n" },
      "time": { "type": ["string", "null"], "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
      "openEnded": { "type": "boolean" },
      "durationMin": { "type": "integer", "minimum": 5, "maximum": 1440 },
      "timeBySide": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "groom": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
          "bride": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" }
        }
      },
      "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "dressCode": {
        "type": "object", "additionalProperties": false, "required": ["en", "swatch"],
        "properties": {
          "en": { "type": "string" }, "hi": { "type": "string" },
          "swatch": { "enum": ["lehariya", "purple", "pastel", "indo-western", "traditional", "any"] }
        }
      },
      "notes": { "$ref": "#/definitions/l10n" },
      "transport": { "$ref": "#/definitions/l10n" },
      "mapLink": { "type": "string", "pattern": "^https://" },
      "audience": { "enum": ["all", "family"] },
      "status": { "enum": ["confirmed", "tbd"] },
      "needsConfirmation": { "type": "boolean" },
      "icon": { "type": "string" },
      "hiDraft": { "type": "boolean" }
    }
  },
  "definitions": {
    "l10n": {
      "type": "object", "additionalProperties": false, "required": ["en"],
      "properties": { "en": { "type": "string", "minLength": 1 }, "hi": { "type": "string" } }
    }
  }
}
